# ============================================
# OpenTYME - Environment Variables Template
# ============================================
# Copy this file to .env and adjust values as needed.
# Defaults work for local development with Docker Compose.
# Do NOT commit your actual .env to version control.

# ============================================
# PUBLIC HOSTNAMES
# ============================================
# Local development defaults use localhost and *.localhost.
# Override these if you want to expose the stack under a custom LAN hostname.
APP_HOST=localhost
AUTH_HOST=auth.localhost
TRAEFIK_HOST=traefik.localhost
MAIL_HOST=mail.localhost
S3_HOST=s3.localhost
MCP_HOST=mcp.localhost
PUBLIC_PROTOCOL=http
PUBLIC_PORT=80

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_DB=opentyme
POSTGRES_PASSWORD=password

# ============================================
# BACKEND CONFIGURATION
# ============================================
NODE_ENV=development
BACKEND_PORT=8000
BACKEND_SECRET_KEY=your-super-secret-key-here
JWT_SECRET=your-jwt-secret-here
DEBUG=true

# ============================================
# KEYCLOAK CONFIGURATION
# ============================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

# ============================================
# FRONTEND CONFIGURATION
# ============================================
FRONTEND_PORT=3000
VITE_APP_ENVIRONMENT=development

# ============================================
# OBJECT STORAGE (SeaweedFS — S3-compatible)
# ============================================
# SeaweedFS is used locally and in Docker Compose.
# For Kubernetes, deploy SeaweedFS StatefulSet + Longhorn PVCs (see k8s/storage/).
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=password
# STORAGE_ENDPOINT and STORAGE_PORT are wired automatically by docker-compose.yml.
# Override here only when running the backend outside Docker:
# STORAGE_ENDPOINT=localhost
# STORAGE_PORT=8333
# STORAGE_USE_SSL=false

# ============================================
# EMAIL (MailHog for development)
# ============================================
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@opentyme.local

# ============================================
# AI / MCP SERVER (Optional - disabled by default)
# ============================================
AI_ENABLED=false

# AI receipt/invoice analysis needs the `mcp-server` service, which sits behind
# the "mcp" compose profile. Uncomment to include it in every `docker compose up`;
# without it the analyze-receipt endpoint fails with
# "getaddrinfo EAI_AGAIN mcp-server".
# COMPOSE_PROFILES=mcp

# Enable LLM-enhanced OCR (requires an API key)
# MCP_ENABLE_LLM=false
# MCP_OPENAI_API_KEY=
# MCP_OPENAI_BASE_URL=http://localhost:1234/v1
# MCP_OPENAI_MODEL=gpt-4o-mini
# MCP_PORT=8001

# AI assistant tuning (optional; defaults shown)
# AI_MAX_TOOLS=20                 # max tools per request (~20 is the local-model reliability cliff)
# AI_MAX_ITERATIONS=12            # max tool-calling loop iterations
# AI_HISTORY_LIMIT=40             # most-recent messages loaded as context
# AI_TEMPERATURE=0.7              # Qwen3 function-calling guidance; near-greedy causes tool-call loops
# AI_TOP_P=0.8                    # Qwen3 function-calling guidance
# AI_PRESENCE_PENALTY=            # optional; Qwen model card suggests up to 1.5 against repetition
# AI_EMBED_MODEL=text-embedding-qwen3-embedding-0.6b
# AI_TOOL_EMBEDDINGS=true         # set false to rank tools lexically only
# AI_TOOL_CONTEXT_BUDGET=24000    # max chars of tool results kept in context
# AI_MAX_OUTPUT_TOKENS=4096       # output cap; truncated tool calls are auto-retried
# AI_STREAM_IDLE_TIMEOUT_MS=120000 # abort if the LLM stream stalls mid-generation
# See docs/ai-architecture-notes.md for the research behind these defaults,
# plus LM Studio settings that matter (preserve_thinking ON, no low max_tokens).

# ============================================
# RATE LIMITING & PROXY (Optional)
# ============================================
# Reverse-proxy hop count (Traefik/Nginx) so req.ip is the real client IP.
# REQUIRED before enabling the global rate limiter, else all users share one IP.
# TRUST_PROXY=2
# RATE_LIMIT_ENABLED=false        # set true (after TRUST_PROXY) to throttle /api per IP
# GLOBAL_RATE_LIMIT_WINDOW_MS=60000
# GLOBAL_RATE_LIMIT_MAX=300

# ============================================
# DEPRECIATION (Optional)
# ============================================
# Degressive AfA (declining-balance) rate = min(FACTOR × linear-rate, CAP).
# These are legally dated and depend on the asset's acquisition year — set them
# to the applicable German rule (e.g. 2.5 / 0.25 for 2020–2022, 2 / 0.20 for
# 2024, 3 / 0.30 for movable assets acquired mid-2025 onward). Defaults: 2024.
# DEPRECIATION_DEGRESSIVE_FACTOR=2
# DEPRECIATION_DEGRESSIVE_CAP=0.20

# ============================================
# BACKUPS (Optional)
# ============================================
# Off-site mirror: every verified backup archive is also copied here, and the
# retention policy prunes mirrored copies too. Must be a path INSIDE the backend
# container — bind-mount your NAS/remote path in docker-compose.yml (see the
# commented "/mirror" volume on the backend service).
# BACKUP_MIRROR_DIR=/mirror

# ============================================
# OBSERVABILITY (Optional)
# ============================================
# Error tracking via Sentry. Requires: cd backend && npm i @sentry/node
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# ============================================
# ADDON / PLUGIN SYSTEM (Optional)
# ============================================
# GitHub token for private addon repos
# GITHUB_ADDON_TOKEN=
# GITLAB_ADDON_TOKEN=

# Comma-separated list of addons to install (overrides addons.config.json)
# OPENTYME_ADDONS=

# ============================================
# PROXY CONFIGURATION
# ============================================
NGINX_PORT=8888

# ============================================
# PRODUCTION OVERRIDES
# ============================================
# When deploying to production, change at minimum:
#   NODE_ENV=production
#   DEBUG=false
#   POSTGRES_PASSWORD=<strong-password>
#   BACKEND_SECRET_KEY=<random-64-char-string>
#   JWT_SECRET=<random-64-char-string>
#   KEYCLOAK_ADMIN_PASSWORD=<strong-password>
#   STORAGE_SECRET_KEY=<strong-password>
#   Configure SSL/TLS via Traefik (see traefik/traefik.yml)
#   Set up proper SMTP credentials for email delivery
#
# Generate strong secrets with:  openssl rand -base64 48
# Rotating secrets on an ALREADY-RUNNING stack needs care (changing POSTGRES_PASSWORD
# in env does NOT change an initialised cluster's password) — see docs/security-hardening.md
